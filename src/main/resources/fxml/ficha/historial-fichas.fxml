<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.edu.sgfa.ficha.ui.HistorialFichasController"
            prefWidth="760" prefHeight="480">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>
    <top>
        <Label fx:id="tituloLabel" styleClass="title-label"/>
    </top>
    <center>
        <TableView fx:id="tabla">
            <columns>
                <TableColumn fx:id="colCorrelativo" text="Correlativo" prefWidth="120"/>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
                <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="120"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                <TableColumn fx:id="colObservacion" text="Observacion" prefWidth="200"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="8">
            <padding>
                <Insets top="12"/>
            </padding>
            <Button text="Ver" onAction="#onVer"/>
            <Button fx:id="botonAnular" text="Anular" onAction="#onAnular" styleClass="button-danger"/>
            <Button text="Cerrar" onAction="#onCerrar"/>
        </HBox>
    </bottom>
</BorderPane>
