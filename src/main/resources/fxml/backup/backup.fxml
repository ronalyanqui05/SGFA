<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.edu.sgfa.backup.ui.BackupController"
            prefWidth="620" prefHeight="480">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>
    <top>
        <Label text="Respaldos de la base de datos" styleClass="title-label"/>
    </top>
    <center>
        <TableView fx:id="tabla">
            <columns>
                <TableColumn fx:id="colArchivo" text="Archivo" prefWidth="260"/>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="160"/>
                <TableColumn fx:id="colTamano" text="Tamano" prefWidth="100"/>
            </columns>
            <BorderPane.margin>
                <Insets top="10" bottom="10"/>
            </BorderPane.margin>
        </TableView>
    </center>
    <bottom>
        <HBox spacing="8">
            <Button text="Respaldar ahora" onAction="#onRespaldar" defaultButton="true"/>
            <Button text="Restaurar seleccionado" onAction="#onRestaurarSeleccionado" styleClass="button-danger"/>
            <Button text="Restaurar desde archivo..." onAction="#onRestaurarDesdeArchivo" styleClass="button-danger"/>
            <Button text="Cerrar" onAction="#onCerrar"/>
        </HBox>
    </bottom>
</BorderPane>
