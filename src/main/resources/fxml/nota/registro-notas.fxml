<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.edu.sgfa.nota.ui.RegistroNotasController"
            prefWidth="820" prefHeight="580">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>
    <top>
        <VBox spacing="8">
            <Label fx:id="estudianteLabel" styleClass="title-label"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Trayectoria:"/>
                <ComboBox fx:id="trayectoriaCombo" prefWidth="220"/>
                <Label text="Periodo:"/>
                <ComboBox fx:id="periodoCombo" prefWidth="140"/>
                <Label text="Ciclo:"/>
                <ComboBox fx:id="cicloCombo" prefWidth="160"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tabla" editable="true">
            <columns>
                <TableColumn fx:id="colCurso" text="Curso" prefWidth="220"/>
                <TableColumn fx:id="colCreditos" text="Creditos" prefWidth="70"/>
                <TableColumn fx:id="colNota" text="Nota" prefWidth="70"/>
                <TableColumn fx:id="colSituacion" text="Situacion" prefWidth="140"/>
                <TableColumn fx:id="colObservacion" text="Observacion" prefWidth="180"/>
                <TableColumn fx:id="colPonderado" text="Ponderado" prefWidth="90"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <VBox spacing="8">
            <padding>
                <Insets top="12"/>
            </padding>
            <Label fx:id="totalesLabel"/>
            <HBox spacing="8">
                <Button text="Guardar" onAction="#onGuardar"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
