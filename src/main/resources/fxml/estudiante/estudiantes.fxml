<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.edu.sgfa.estudiante.ui.EstudiantesController"
            prefWidth="820" prefHeight="560">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>
    <top>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Buscar:"/>
            <TextField fx:id="busquedaField" prefWidth="340" promptText="DNI, codigo, nombres o apellidos (se filtra al escribir)"/>
            <Button text="Buscar" onAction="#onBuscar" defaultButton="true"/>
            <Button text="Mostrar todos" onAction="#onMostrarTodos"/>
            <CheckBox fx:id="incluirInactivosCheck" text="Incluir inactivos"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="tabla">
            <columns>
                <TableColumn fx:id="colCodigo" text="Codigo" prefWidth="90"/>
                <TableColumn fx:id="colDni" text="DNI" prefWidth="90"/>
                <TableColumn fx:id="colApellidosNombres" text="Apellidos y Nombres" prefWidth="320"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="90"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox spacing="8">
            <padding>
                <Insets top="12"/>
            </padding>
            <Button text="Nuevo" onAction="#onNuevo"/>
            <Button text="Editar" onAction="#onEditar"/>
            <Button text="Inactivar/Reactivar" onAction="#onToggleEstado"/>
            <Button text="Trayectoria" onAction="#onTrayectoria"/>
            <Button text="Registrar notas" onAction="#onRegistrarNotas"/>
            <Button text="Generar ficha" onAction="#onGenerarFicha"/>
            <Button text="Historial de fichas" onAction="#onHistorialFichas"/>
        </HBox>
    </bottom>
</BorderPane>
