<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.edu.sgfa.auditoria.ui.AuditoriaController"
            prefWidth="960" prefHeight="620">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>
    <top>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Desde:"/>
            <DatePicker fx:id="desdePicker" prefWidth="130"/>
            <Label text="Hasta:"/>
            <DatePicker fx:id="hastaPicker" prefWidth="130"/>
            <Label text="Usuario:"/>
            <ComboBox fx:id="usuarioCombo" prefWidth="160"/>
            <Label text="Accion:"/>
            <ComboBox fx:id="accionCombo" prefWidth="150"/>
            <Label text="Entidad:"/>
            <ComboBox fx:id="entidadCombo" prefWidth="140"/>
            <Button text="Buscar" onAction="#onBuscar" defaultButton="true"/>
            <Button text="Limpiar" onAction="#onLimpiar"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="tabla">
            <columns>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="140"/>
                <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="150"/>
                <TableColumn fx:id="colAccion" text="Accion" prefWidth="150"/>
                <TableColumn fx:id="colEntidad" text="Entidad" prefWidth="130"/>
                <TableColumn fx:id="colEntidadId" text="Id" prefWidth="60"/>
                <TableColumn fx:id="colDetalle" text="Detalle" prefWidth="260"/>
            </columns>
            <BorderPane.margin>
                <Insets top="10" bottom="10"/>
            </BorderPane.margin>
        </TableView>
    </center>
    <bottom>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="anteriorButton" text="Anterior" onAction="#onAnterior"/>
            <Button fx:id="siguienteButton" text="Siguiente" onAction="#onSiguiente"/>
            <Label fx:id="paginaLabel"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Cerrar" onAction="#onCerrar"/>
        </HBox>
    </bottom>
</BorderPane>
