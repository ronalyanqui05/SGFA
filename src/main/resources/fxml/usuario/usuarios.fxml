<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.edu.sgfa.usuario.ui.UsuariosController"
            prefWidth="640" prefHeight="420">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <center>
        <TableView fx:id="tabla">
            <columns>
                <TableColumn fx:id="colUsername" text="Usuario" prefWidth="140"/>
                <TableColumn fx:id="colNombres" text="Nombres" prefWidth="220"/>
                <TableColumn fx:id="colRol" text="Rol" prefWidth="100"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox spacing="8">
            <padding>
                <Insets top="12"/>
            </padding>
            <Button text="Nuevo" onAction="#onNuevo"/>
            <Button text="Editar" onAction="#onEditar"/>
            <Button text="Activar/Desactivar" onAction="#onToggleActivo"/>
            <Button text="Cambiar contrasena" onAction="#onCambiarPassword"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Cerrar" onAction="#onCerrar"/>
        </HBox>
    </bottom>
</BorderPane>
