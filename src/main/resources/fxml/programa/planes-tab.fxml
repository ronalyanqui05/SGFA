<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.edu.sgfa.programa.ui.PlanesTabController">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>
    <top>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Programa:"/>
            <ComboBox fx:id="programaCombo" prefWidth="320"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="tabla">
            <columns>
                <TableColumn fx:id="colCodigo" text="Codigo" prefWidth="100"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="220"/>
                <TableColumn fx:id="colFechas" text="Vigencia" prefWidth="180"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="90"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox spacing="8">
            <padding>
                <Insets top="12"/>
            </padding>
            <Button text="Nuevo" onAction="#onNuevo"/>
            <Button text="Editar" onAction="#onEditar"/>
            <Button text="Abrir / Activar plan" onAction="#onAbrir"/>
            <Button text="Cerrar plan" onAction="#onCerrar"/>
            <Button text="Eliminar" onAction="#onEliminar" styleClass="button-danger"/>
        </HBox>
    </bottom>
</BorderPane>
