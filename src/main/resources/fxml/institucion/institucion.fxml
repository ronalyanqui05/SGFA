<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.edu.sgfa.institucion.ui.InstitucionController"
      spacing="16"
      prefWidth="520" prefHeight="480">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label text="Configuracion institucional" styleClass="title-label"/>

    <HBox spacing="16" alignment="CENTER_LEFT">
        <ImageView fx:id="logoPreview" fitWidth="96" fitHeight="96" preserveRatio="true"/>
        <Button text="Cambiar logo" onAction="#onCambiarLogo"/>
    </HBox>

    <HBox spacing="16" alignment="CENTER_LEFT">
        <ImageView fx:id="fondoPreview" fitWidth="96" fitHeight="64" preserveRatio="true"/>
        <VBox spacing="4">
            <Label text="Fondo de la pantalla de inicio" styleClass="field-label"/>
            <HBox spacing="8">
                <Button text="Cargar fondo" onAction="#onCambiarFondo"/>
                <Button text="Quitar fondo" onAction="#onQuitarFondo"/>
            </HBox>
        </VBox>
    </HBox>

    <GridPane hgap="8" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="260"/>
        </columnConstraints>
        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nombreField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Siglas:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="siglasField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Direccion:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="direccionField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Telefono:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="telefonoField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="Correo:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="correoField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="8">
        <Button text="Guardar" defaultButton="true" onAction="#onGuardar"/>
        <Button text="Cerrar" onAction="#onCerrar"/>
    </HBox>
</VBox>
