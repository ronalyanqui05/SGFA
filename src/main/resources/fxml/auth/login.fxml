<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.edu.sgfa.usuario.ui.LoginController"
      prefWidth="960" prefHeight="650">

    <VBox fx:id="panelMarca" styleClass="login-brand-panel" alignment="CENTER" spacing="18" prefWidth="500" HBox.hgrow="ALWAYS">
        <ImageView fx:id="logoLogin" fitWidth="130" fitHeight="130" preserveRatio="true" smooth="true"
                   visible="false" managed="false"/>
        <Label text="SGFA" styleClass="brand-title"/>
        <Label text="Sistema de Gestion de Fichas Academicas" styleClass="brand-subtitle"
               wrapText="true" textAlignment="CENTER" maxWidth="320"/>
        <Region prefHeight="30"/>
        <Label text="Gestion academica offline, simple y segura para institutos pedagogicos."
               styleClass="brand-tagline" wrapText="true" textAlignment="CENTER" maxWidth="300"/>
    </VBox>

    <VBox styleClass="login-form-panel" alignment="CENTER" prefWidth="460">
        <HBox alignment="TOP_RIGHT" maxWidth="Infinity">
            <Button fx:id="temaButton" onAction="#onAlternarTema" styleClass="theme-toggle-button"/>
            <VBox.margin>
                <Insets bottom="10"/>
            </VBox.margin>
        </HBox>
        <VBox styleClass="login-card" alignment="CENTER" spacing="16" maxWidth="300">
            <Label text="Iniciar sesion" styleClass="title-label"/>
            <Label text="Ingrese sus credenciales para continuar" styleClass="subtitle-label"
                   wrapText="true" textAlignment="CENTER"/>

            <VBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Usuario" styleClass="field-label"/>
                <TextField fx:id="usernameField" promptText="Usuario" prefWidth="260"/>
            </VBox>
            <VBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Contrasena" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="Contrasena" prefWidth="260"/>
            </VBox>

            <Button fx:id="loginButton" text="Ingresar" defaultButton="true" onAction="#onLogin"
                    styleClass="login-button" prefWidth="260">
                <VBox.margin>
                    <Insets top="6"/>
                </VBox.margin>
            </Button>
            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" maxWidth="260"
                   textAlignment="CENTER"/>
        </VBox>
    </VBox>
</HBox>
