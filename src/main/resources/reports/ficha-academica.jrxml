<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ficha-academica" pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="16" bottomMargin="14"
              uuid="d3b4a2e0-1a2b-4c3d-9e0f-123456789abc">

    <style name="Base" isDefault="true" fontName="SansSerif" fontSize="9"
           pdfFontName="Helvetica" pdfEncoding="Cp1252" isPdfEmbedded="false"/>
    <style name="Titulo" fontName="SansSerif" isBold="true" fontSize="16"
           pdfFontName="Helvetica-Bold" pdfEncoding="Cp1252" isPdfEmbedded="false"/>
    <style name="Subtitulo" fontName="SansSerif" isBold="true" fontSize="11"
           pdfFontName="Helvetica-Bold" pdfEncoding="Cp1252" isPdfEmbedded="false"/>
    <style name="Institucion" fontName="SansSerif" isBold="true" fontSize="10"
           pdfFontName="Helvetica-Bold" pdfEncoding="Cp1252" isPdfEmbedded="false"/>
    <style name="Encabezado" fontName="SansSerif" isBold="true" fontSize="8"
           pdfFontName="Helvetica-Bold" pdfEncoding="Cp1252" isPdfEmbedded="false"/>
    <style name="Pequena" fontName="SansSerif" fontSize="8"
           pdfFontName="Helvetica" pdfEncoding="Cp1252" isPdfEmbedded="false"/>
    <style name="Cursiva" fontName="SansSerif" isItalic="true" fontSize="8"
           pdfFontName="Helvetica-Oblique" pdfEncoding="Cp1252" isPdfEmbedded="false"/>

    <parameter name="correlativo" class="java.lang.String"/>
    <parameter name="institucionNombre" class="java.lang.String"/>
    <parameter name="institucionSiglas" class="java.lang.String"/>
    <parameter name="institucionDireccion" class="java.lang.String"/>
    <parameter name="logoPath" class="java.lang.String"/>
    <parameter name="estudianteNombreCompleto" class="java.lang.String"/>
    <parameter name="estudianteDni" class="java.lang.String"/>
    <parameter name="estudianteCodigo" class="java.lang.String"/>
    <parameter name="programaNombre" class="java.lang.String"/>
    <parameter name="planNombre" class="java.lang.String"/>
    <parameter name="fechaEmision" class="java.lang.String"/>

    <field name="cicloNumero" class="java.lang.Integer"/>
    <field name="cicloNombre" class="java.lang.String"/>
    <field name="cicloTitulo" class="java.lang.String"/>
    <field name="cursoNombre" class="java.lang.String"/>
    <field name="creditos" class="java.lang.Integer"/>
    <field name="notaFinal" class="java.lang.Double"/>
    <field name="ponderado" class="java.lang.Double"/>
    <field name="fechaRegistro" class="java.lang.String"/>
    <field name="observacion" class="java.lang.String"/>
    <field name="promedioCiclo" class="java.lang.Double"/>
    <field name="totalCreditosCiclo" class="java.lang.Integer"/>
    <field name="sumaPonderadaCiclo" class="java.lang.Double"/>

    <group name="GrupoCiclo" keepTogether="true">
        <groupExpression><![CDATA[$F{cicloNumero}]]></groupExpression>
        <groupHeader>
            <band height="27">
                <rectangle>
                    <reportElement mode="Opaque" x="0" y="0" width="515" height="14" backcolor="#DCE5F1"/>
                    <graphicElement>
                        <pen lineWidth="0.0"/>
                    </graphicElement>
                </rectangle>
                <rectangle>
                    <reportElement mode="Opaque" x="0" y="14" width="515" height="12" backcolor="#F1F4F8"/>
                    <graphicElement>
                        <pen lineWidth="0.0"/>
                    </graphicElement>
                </rectangle>
                <textField>
                    <reportElement x="4" y="1" width="511" height="15" style="Subtitulo"/>
                    <textFieldExpression><![CDATA[$F{cicloTitulo}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="0" y="14" width="277" height="11" style="Encabezado"/>
                    <text><![CDATA[Curso]]></text>
                </staticText>
                <staticText>
                    <reportElement x="281" y="14" width="28" height="11" style="Encabezado"/>
                    <textElement textAlignment="Right"/>
                    <text><![CDATA[Nota]]></text>
                </staticText>
                <staticText>
                    <reportElement x="313" y="14" width="35" height="11" style="Encabezado"/>
                    <textElement textAlignment="Right"/>
                    <text><![CDATA[Creditos]]></text>
                </staticText>
                <staticText>
                    <reportElement x="352" y="14" width="40" height="11" style="Encabezado"/>
                    <textElement textAlignment="Right"/>
                    <text><![CDATA[Puntaje]]></text>
                </staticText>
                <staticText>
                    <reportElement x="398" y="14" width="52" height="11" style="Encabezado"/>
                    <text><![CDATA[Fecha]]></text>
                </staticText>
                <staticText>
                    <reportElement x="455" y="14" width="60" height="11" style="Encabezado"/>
                    <text><![CDATA[Observaciones]]></text>
                </staticText>
                <line>
                    <reportElement x="0" y="26" width="515" height="1"/>
                </line>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="15">
                <rectangle>
                    <reportElement mode="Opaque" x="0" y="2" width="515" height="12" backcolor="#F1F4F8"/>
                    <graphicElement>
                        <pen lineWidth="0.0"/>
                    </graphicElement>
                </rectangle>
                <line>
                    <reportElement x="0" y="1" width="515" height="1"/>
                </line>
                <staticText>
                    <reportElement x="0" y="3" width="265" height="11" style="Encabezado"/>
                    <text><![CDATA[Promedio ponderado semestral / Total]]></text>
                </staticText>
                <textField>
                    <reportElement x="269" y="3" width="40" height="11" style="Encabezado"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA[$F{promedioCiclo} == null ? "-" : new java.text.DecimalFormat("0.00").format($F{promedioCiclo})]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="313" y="3" width="35" height="11" style="Encabezado"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA[$F{totalCreditosCiclo}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="352" y="3" width="40" height="11" style="Encabezado"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA[new java.text.DecimalFormat("0.0").format($F{sumaPonderadaCiclo})]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <title>
        <band height="146">
            <image scaleImage="RetainShape">
                <reportElement x="0" y="0" width="72" height="72">
                    <printWhenExpression><![CDATA[$P{logoPath} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{logoPath}]]></imageExpression>
            </image>

            <textField isStretchWithOverflow="true">
                <reportElement x="78" y="12" width="359" height="14" style="Institucion"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{institucionNombre} + ($P{institucionSiglas} != null && !$P{institucionSiglas}.isEmpty() ? " (" + $P{institucionSiglas} + ")" : "")]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="42" width="515" height="24" style="Titulo"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[FICHA ACADEMICA]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="66" width="515" height="12" style="Encabezado">
                    <printWhenExpression><![CDATA[$P{correlativo} != null]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Ficha N° " + $P{correlativo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="66" width="515" height="12" style="Encabezado" forecolor="#B33A3A">
                    <printWhenExpression><![CDATA[$P{correlativo} == null]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["BORRADOR - VISTA PREVIA, no es un documento oficial"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="80" width="515" height="1"/>
            </line>
            <textField>
                <reportElement x="0" y="88" width="340" height="14"/>
                <textFieldExpression><![CDATA["Apellidos y nombres: " + $P{estudianteNombreCompleto}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="340" y="88" width="175" height="14"/>
                <textFieldExpression><![CDATA["DNI: " + ($P{estudianteDni} == null ? "-" : $P{estudianteDni})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="102" width="340" height="14"/>
                <textFieldExpression><![CDATA["Codigo: " + ($P{estudianteCodigo} == null ? "-" : $P{estudianteCodigo})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="116" width="515" height="14"/>
                <textFieldExpression><![CDATA["Programa de estudios: " + $P{programaNombre}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="130" width="515" height="14"/>
                <textFieldExpression><![CDATA["Plan de estudios: " + $P{planNombre}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <pageHeader>
        <band height="26">
            <printWhenExpression><![CDATA[$V{PAGE_NUMBER} > 1]]></printWhenExpression>
            <textField>
                <reportElement x="0" y="2" width="515" height="12" style="Cursiva"/>
                <textFieldExpression><![CDATA[$P{institucionNombre} + " - " + $P{estudianteNombreCompleto} + " - FICHA ACADEMICA"]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="16" width="515" height="1" forecolor="#B8BEC8"/>
                <graphicElement>
                    <pen lineWidth="0.75" lineColor="#B8BEC8"/>
                </graphicElement>
            </line>
        </band>
    </pageHeader>

    <detail>
        <band height="11">
            <textField isStretchWithOverflow="true">
                <reportElement positionType="Float" x="0" y="0" width="277" height="11" style="Pequena"/>
                <textFieldExpression><![CDATA[$F{cursoNombre}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="281" y="0" width="28" height="11" style="Pequena"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{notaFinal} == null ? "-" : new java.text.DecimalFormat("0.0").format($F{notaFinal})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="313" y="0" width="35" height="11" style="Pequena"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{creditos}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="352" y="0" width="40" height="11" style="Pequena"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{ponderado} == null ? "-" : new java.text.DecimalFormat("0.0").format($F{ponderado})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="398" y="0" width="52" height="11" style="Pequena"/>
                <textFieldExpression><![CDATA[$F{fechaRegistro} == null ? "-" : $F{fechaRegistro}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="455" y="0" width="60" height="11" style="Pequena"/>
                <textFieldExpression><![CDATA[$F{observacion} == null ? "" : $F{observacion}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="14">
            <line>
                <reportElement x="0" y="0" width="515" height="1"/>
            </line>
            <textField>
                <reportElement x="0" y="2" width="250" height="11" style="Pequena"/>
                <textFieldExpression><![CDATA["Fecha de emision: " + $P{fechaEmision}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="370" y="2" width="60" height="11" style="Pequena"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Pagina " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="433" y="2" width="16" height="11" style="Pequena"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[de]]></text>
            </staticText>
            <textField evaluationTime="Report">
                <reportElement x="452" y="2" width="30" height="11" style="Pequena"/>
                <textFieldExpression><![CDATA["" + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="154">
            <line>
                <reportElement x="60" y="136" width="180" height="1"/>
            </line>
            <staticText>
                <reportElement x="60" y="138" width="180" height="12" style="Pequena"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Secretario Académico]]></text>
            </staticText>
            <line>
                <reportElement x="280" y="136" width="180" height="1"/>
            </line>
            <staticText>
                <reportElement x="280" y="138" width="180" height="12" style="Pequena"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Director General]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
